{
    // VSCode 任务：Ctrl+Shift+B 构建（默认任务），F5 前会自动跑 build
    // 任务列表里可以直接运行 flash / test / check-layers
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}/node"
    },
    "tasks": [
        {
            "label": "build",
            // 不用绝对路径调 gcc：Makefile 自己会在 ~/opt 下找工具链
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            // fileLocation 让点击错误能跳到源码：make 在 node/ 下跑，输出的是相对路径
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["relative", "${workspaceFolder}/node"]
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            // 调试启动前先清掉残留的 openocd。
            // 上一次调试异常退出时，旧 openocd 可能还攥着 ST-Link 和 3333 端口，
            // 新会话就连到一个正在退出的服务上 —— 现象正是"能停在复位，
            // 一按继续就弹 A serious error occurred with gdb, unable to continue or interrupt"。
            "label": "kill-openocd",
            "type": "shell",
            "command": "pkill -x openocd || true",
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            // 纯烧写（不改代码、只想更新板子里的固件时用）
            "label": "flash",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32f4x.cfg",
                "-c", "adapter speed 1800",
                "-c", "program ${workspaceFolder}/node/vision-node.elf verify reset exit"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "test",
            "type": "shell",
            "command": "make test",
            "problemMatcher": []
        },
        {
            "label": "check-layers",
            "type": "shell",
            "command": "make check-layers",
            "problemMatcher": []
        }
    ]
}
