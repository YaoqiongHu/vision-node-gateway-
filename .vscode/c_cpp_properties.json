{
  "version": 4,
  "configurations": [
    {
      "name": "STM32F407 (arm-none-eabi-gcc)",
      "compilerPath": "${env:HOME}/opt/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gcc",
      "compilerArgs": [
        "-mcpu=cortex-m4",
        "-mthumb",
        "-mfpu=fpv4-sp-d16",
        "-mfloat-abi=hard"
      ],
      "intelliSenseMode": "gcc-arm",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "defines": [
        "STM32F407xx",
        "HSE_VALUE=8000000",
        "HSI_VALUE=16000000"
      ],
      "includePath": [
        "${workspaceFolder}/node/arch/cmsis",
        "${workspaceFolder}/node/arch",
        "${workspaceFolder}/node/bsp",
        "${workspaceFolder}/node/drv",
        "${workspaceFolder}/node/os",
        "${workspaceFolder}/node/lib",
        "${workspaceFolder}/node/proto",
        "${workspaceFolder}/node/app",
        "${workspaceFolder}/node/config",
        "${workspaceFolder}/node/test",
        "${workspaceFolder}/shared/proto",
        "${env:HOME}/opt/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/arm-none-eabi/include",
        "${env:HOME}/opt/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/lib/gcc/arm-none-eabi/14.3.1/include"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/node",
          "${workspaceFolder}/shared"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
